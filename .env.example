# Camera device index and requested capture resolution
CAMERA_INDEX=0
FRAME_WIDTH=960
FRAME_HEIGHT=540
CAMERA_MIRROR=true

# Computer input starts disarmed. Press Space in the camera window to arm.
CONTROLS_ENABLED=false
MOUSE_CONTROL_ENABLED=true
KEYBOARD_CONTROL_ENABLED=true

# Tracking and interaction tuning
DETECTION_CONFIDENCE=0.65
TRACKING_CONFIDENCE=0.65
MOUSE_SMOOTHING=0.28
ACTION_COOLDOWN=0.8
GESTURE_STABILITY_FRAMES=4
PINCH_THRESHOLD=0.055

# Local session summary file
STATS_FILE=data/session_stats.json
LOG_LEVEL=INFO
